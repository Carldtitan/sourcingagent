# Gmail: sending over SMTP, receiving over IMAP.
# Create a throwaway Google account, turn on 2-Step Verification, then make an
# app password at myaccount.google.com/apppasswords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Anthropic: the agents reason with Claude Sonnet 5.
ANTHROPIC_API_KEY=

# Supabase: project settings, then API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase: project settings, then Database, then Connection string (session
# pooler). Only needed to run migrations from the command line.
DATABASE_URL=
